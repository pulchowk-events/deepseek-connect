{
  "manifest_version": 3,
  "name": "deepseek-connect",
  "version": "0.3.0",
  "description": "Drives real AI chat tabs (DeepSeek, Qwen, etc.) over a local HTTP server.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "file:///*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://tongyi.aliyun.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://chatgpt.com/*",
        "file:///*mock-deepseek.html"
      ],
      "js": [
        "shared.js",
        "selectors.js",
        "providers/deepseek.js",
        "providers/qwen.js",
        "providers/chatgpt.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "deepseek-connect",
    "default_popup": "popup.html"
  }
}
